<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>EnergyBar</AssemblyName>
    <!-- GameDir / Managed / 部署开关这些公共设置，见根目录的 Directory.Build.props -->
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(Managed)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(Managed)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ModTexture Include="Textures\Items\*.png" />
  </ItemGroup>

  <!-- 编译完直接丢进 Mods，省得每次手动拷；-p:DeployToMods=false 可以只编译 -->
  <Target Name="ToMods" AfterTargets="Build" Condition="'$(DeployToMods)' != 'false'">
    <Copy SourceFiles="$(TargetPath);manifest.xml" DestinationFolder="$(GameModsDir)\EnergyBar" />
    <Copy SourceFiles="@(ModTexture)" DestinationFolder="$(GameModsDir)\EnergyBar\Textures\Items" Condition="'@(ModTexture)' != ''" />
  </Target>

</Project>
