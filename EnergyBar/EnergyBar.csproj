<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>EnergyBar</AssemblyName>
    <!-- 游戏装哪儿就改哪儿 -->
    <GameDir>E:\SteamLibrary\steamapps\common\Probably Stolen</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\Probably Stolen_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\Probably Stolen_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\Probably Stolen_Data\Managed\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ModTexture Include="Textures\Items\*.png" />
  </ItemGroup>

  <!-- 编译完直接丢进 Mods，省得每次手动拷 -->
  <Target Name="ToMods" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath);manifest.xml" DestinationFolder="$(GameDir)\Mods\EnergyBar" />
    <Copy SourceFiles="@(ModTexture)" DestinationFolder="$(GameDir)\Mods\EnergyBar\Textures\Items" />
  </Target>

</Project>
